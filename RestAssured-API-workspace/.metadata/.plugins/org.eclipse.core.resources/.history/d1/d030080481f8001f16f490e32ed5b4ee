package Practice4;

import org.testng.Assert;
import org.testng.annotations.Test;

import io.restassured.http.ContentType;
import io.restassured.response.Response;

import static io.restassured.RestAssured.*;
import static io.restassured.matcher.RestAssuredMatchers.*;
import static org.hamcrest.Matchers.*;

import org.json.JSONArray;
import org.json.JSONObject;


public class ParsingJSONResponse {
	
	@Test
	void TestParsingJSON() {
		
     Response res=    given()
		 	.contentType("content-type.json")
		.when()
			.get("http://localhost:3000/store");
     
	Assert.assertEquals(res.getStatusCode(), 200);
	
	String phoneName=res.jsonPath().get("[1].name").toString();
	Assert.assertEquals(phoneName, "Phone");
	}
	
	
	@Test(priority=1)
	void usingJSONObjectClass() {
		
		Response res=given()
						.contentType(ContentType.JSON)
					.when()
						.get("http://localhost:3000/store");
		
		//create jsonObject class object
		JSONArray jo=new JSONArray(res.asString());
		
		for(int i=0;i<=jo.length();i++) {
			String prodName=jo.getJSONObject(i).get("name").toString();	
			System.out.println(prodName);
		}
		
	}

}
